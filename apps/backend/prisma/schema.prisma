// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  VENDOR
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  MPESA
  CARD
  CASH_ON_DELIVERY
}

enum VendorStatus {
  PENDING
  APPROVED
  SUSPENDED
  REJECTED
}

enum DeliveryStatus {
  PENDING
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  password          String?
  firstName         String?
  lastName          String?
  phone             String?   @unique
  role              UserRole  @default(CUSTOMER)
  isActive          Boolean   @default(true)
  emailVerified     Boolean   @default(false)
  phoneVerified     Boolean   @default(false)
  avatar            String?
  dateOfBirth       DateTime?

  // Auth fields
  resetToken        String?   @unique
  resetTokenExpiry  DateTime?
  verificationToken String?   @unique

  // Timestamps
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  lastLoginAt       DateTime?

  // Relations
  vendor            Vendor?
  addresses         Address[]
  orders            Order[]
  reviews           Review[]
  cart              CartItem[]
  wishlist          Wishlist[]
  userCoupons       UserCoupon[]

  @@index([email])
  @@index([phone])
  @@index([role])
}

model Vendor {
  id              String        @id @default(cuid())
  userId          String        @unique
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  businessName    String
  businessEmail   String        @unique
  businessPhone   String
  description     String?
  logo            String?
  banner          String?

  // Business details
  registrationNumber String?    @unique
  taxId           String?

  // Banking details for payouts
  bankName        String?
  accountNumber   String?
  accountName     String?

  // Commission
  commissionRate  Float         @default(15.0) // Percentage

  // Status
  status          VendorStatus  @default(PENDING)
  isVerified      Boolean       @default(false)

  // Analytics
  totalSales      Float         @default(0)
  totalOrders     Int           @default(0)
  rating          Float         @default(0)
  totalReviews    Int           @default(0)

  // Timestamps
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  approvedAt      DateTime?

  // Relations
  products        Product[]
  orders          Order[]
  payouts         Payout[]
  coupons         Coupon[]

  @@index([status])
  @@index([businessName])
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  image       String?
  parentId    String?
  parent      Category? @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")

  isActive    Boolean   @default(true)
  order       Int       @default(0)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products    Product[]
  coupons     Coupon[]

  @@index([slug])
  @@index([parentId])
}

model Product {
  id              String    @id @default(cuid())
  name            String
  slug            String    @unique
  description     String
  shortDescription String?

  // Pricing
  price           Float
  compareAtPrice  Float?    // Original price for discounts
  costPrice       Float?    // For profit calculation

  // Inventory
  sku             String    @unique
  barcode         String?
  trackInventory  Boolean   @default(true)
  stock           Int       @default(0)
  lowStockThreshold Int     @default(10)

  // Media
  images          String[]  @default([])
  thumbnail       String?

  // SEO
  metaTitle       String?
  metaDescription String?
  metaKeywords    String[]  @default([])

  // Status
  isActive        Boolean   @default(true)
  isFeatured      Boolean   @default(false)

  // Vendor
  vendorId        String
  vendor          Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  // Category
  categoryId      String
  category        Category  @relation(fields: [categoryId], references: [id])

  // Analytics
  views           Int       @default(0)
  totalSales      Int       @default(0)
  revenue         Float     @default(0)
  rating          Float     @default(0)
  totalReviews    Int       @default(0)

  // Timestamps
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  orderItems      OrderItem[]
  reviews         Review[]
  cartItems       CartItem[]
  wishlist        Wishlist[]
  inventoryLogs   InventoryLog[]

  @@index([slug])
  @@index([vendorId])
  @@index([categoryId])
  @@index([isActive])
  @@index([isFeatured])
}

model Order {
  id              String        @id @default(cuid())
  orderNumber     String        @unique

  // Customer
  userId          String
  user            User          @relation(fields: [userId], references: [id])

  // Vendor
  vendorId        String
  vendor          Vendor        @relation(fields: [vendorId], references: [id])

  // Pricing
  subtotal        Float
  tax             Float         @default(0)
  shippingFee     Float         @default(0)
  discount        Float         @default(0)
  total           Float

  // Coupon
  couponId        String?
  coupon          Coupon?       @relation(fields: [couponId], references: [id])
  couponCode      String?
  couponDiscount  Float         @default(0)

  // Commission
  commissionRate  Float
  commissionAmount Float
  vendorPayout    Float

  // Status
  status          OrderStatus   @default(PENDING)
  paymentStatus   PaymentStatus @default(PENDING)

  // Delivery
  shippingAddressId String
  shippingAddress   Address     @relation(fields: [shippingAddressId], references: [id])

  // Notes
  customerNotes   String?
  vendorNotes     String?

  // Timestamps
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  confirmedAt     DateTime?
  shippedAt       DateTime?
  deliveredAt     DateTime?
  cancelledAt     DateTime?

  // Relations
  items           OrderItem[]
  payment         Payment?
  delivery        Delivery?

  @@index([userId])
  @@index([vendorId])
  @@index([orderNumber])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id              String    @id @default(cuid())

  orderId         String
  order           Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId       String
  product         Product   @relation(fields: [productId], references: [id])

  quantity        Int
  price           Float     // Price at time of purchase
  total           Float

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id                String        @id @default(cuid())

  orderId           String        @unique
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  amount            Float
  currency          String        @default("KES")
  method            PaymentMethod
  status            PaymentStatus @default(PENDING)

  // M-Pesa specific fields
  mpesaReceiptNumber String?      @unique
  phoneNumber       String?
  transactionId     String?       @unique
  transactionDate   DateTime?

  // Metadata
  metadata          Json?

  // Timestamps
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  paidAt            DateTime?

  @@index([status])
  @@index([mpesaReceiptNumber])
  @@index([transactionId])
}

model Delivery {
  id                String          @id @default(cuid())

  orderId           String          @unique
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)

  status            DeliveryStatus  @default(PENDING)

  trackingNumber    String?         @unique
  courier           String?

  estimatedDelivery DateTime?

  // Current location
  currentLocation   String?
  currentLat        Float?
  currentLng        Float?

  // Notes
  notes             String?

  // Timestamps
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  pickedUpAt        DateTime?
  deliveredAt       DateTime?

  // Relations
  trackingEvents    DeliveryTracking[]

  @@index([status])
  @@index([trackingNumber])
}

model DeliveryTracking {
  id          String   @id @default(cuid())

  deliveryId  String
  delivery    Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  status      DeliveryStatus
  location    String?
  latitude    Float?
  longitude   Float?
  description String?

  createdAt   DateTime @default(now())

  @@index([deliveryId])
  @@index([createdAt])
}

model Review {
  id          String   @id @default(cuid())

  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  rating      Int      // 1-5
  title       String?
  comment     String
  images      String[] @default([])

  isVerified  Boolean  @default(false) // Verified purchase
  isApproved  Boolean  @default(true)

  helpfulCount Int     @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([productId, userId])
  @@index([productId])
  @@index([userId])
  @@index([rating])
}

model Address {
  id          String   @id @default(cuid())

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  type        String   @default("shipping") // shipping, billing
  isDefault   Boolean  @default(false)

  firstName   String
  lastName    String
  phone       String

  address1    String
  address2    String?
  city        String
  state       String?
  county      String?
  postalCode  String?
  country     String   @default("KE")

  latitude    Float?
  longitude   Float?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders      Order[]

  @@index([userId])
}

model CartItem {
  id          String   @id @default(cuid())

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  quantity    Int      @default(1)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, productId])
  @@index([userId])
}

model Wishlist {
  id          String   @id @default(cuid())

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
}

model InventoryLog {
  id          String   @id @default(cuid())

  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  type        String   // PURCHASE, SALE, ADJUSTMENT, RETURN
  quantity    Int      // Positive for increase, negative for decrease
  previousStock Int
  newStock    Int

  reason      String?
  reference   String?  // Order ID, etc.

  createdAt   DateTime @default(now())

  @@index([productId])
  @@index([createdAt])
}

model Payout {
  id              String   @id @default(cuid())

  vendorId        String
  vendor          Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  amount          Float
  currency        String   @default("KES")
  status          PaymentStatus @default(PENDING)

  // Banking details
  bankName        String
  accountNumber   String
  accountName     String

  // M-Pesa B2C
  mpesaTransactionId String? @unique
  phoneNumber     String?

  // Metadata
  periodStart     DateTime
  periodEnd       DateTime
  orderCount      Int      @default(0)

  notes           String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  paidAt          DateTime?

  @@index([vendorId])
  @@index([status])
}

enum CouponType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

model Coupon {
  id              String      @id @default(cuid())

  code            String      @unique
  type            CouponType
  value           Float       // Percentage (0-100) or fixed amount

  description     String?

  // Restrictions
  minPurchase     Float?      // Minimum order amount
  maxDiscount     Float?      // Maximum discount amount (for percentage)
  usageLimit      Int?        // Total usage limit
  usagePerUser    Int?        // Usage limit per user

  // Applicability
  categoryId      String?
  category        Category?   @relation(fields: [categoryId], references: [id])
  vendorId        String?
  vendor          Vendor?     @relation(fields: [vendorId], references: [id])
  productIds      String[]    @default([])  // Specific products

  // Status
  isActive        Boolean     @default(true)

  // Time constraints
  startDate       DateTime?
  expiryDate      DateTime?

  // Usage tracking
  timesUsed       Int         @default(0)

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // Relations
  orders          Order[]
  userCoupons     UserCoupon[]

  @@index([code])
  @@index([isActive])
  @@index([expiryDate])
}

model UserCoupon {
  id          String   @id @default(cuid())

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  couponId    String
  coupon      Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)

  timesUsed   Int      @default(0)

  createdAt   DateTime @default(now())

  @@unique([userId, couponId])
  @@index([userId])
  @@index([couponId])
}
