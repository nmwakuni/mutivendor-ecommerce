# ==========================================
# Root .dockerignore
# For building from monorepo root
# ==========================================

# Dependencies
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock
pnpm-lock.yaml

# Build outputs
dist
build
.next
out
apps/*/dist
apps/*/build
apps/*/.next

# Environment files (use build args instead)
.env
.env.local
.env.development
.env.test
.env.production
*.local

# Git
.git
.gitignore
.gitattributes
.github

# CI/CD
.gitlab-ci.yml
.travis.yml
.circleci

# IDE
.vscode
.idea
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Documentation
README.md
CHANGELOG.md
LICENSE
*.md
docs

# Testing
coverage
.nyc_output
**/test
**/__tests__
**/__mocks__
*.test.ts
*.test.js
*.spec.ts
*.spec.js
jest.config.js
jest.config.ts
cypress
cypress.json

# Logs
logs
*.log

# Docker files themselves
Dockerfile*
.dockerignore
docker-compose*.yml
.docker

# Misc config files
.eslintrc*
.prettierrc*
.editorconfig
tsconfig*.json
next.config.js
tailwind.config.js
postcss.config.js

# TypeScript
*.tsbuildinfo

# Database
prisma/migrations
*.db
*.sqlite

# Temporary files
tmp
temp
