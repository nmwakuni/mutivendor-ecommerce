# ==========================================
# Multi-Vendor Marketplace - Environment Variables
# Copy this file to .env and fill in your values
# ==========================================

# ==========================================
# Application Environment
# ==========================================
NODE_ENV=production
# Options: development, production, test

# ==========================================
# Database (PostgreSQL)
# ==========================================
POSTGRES_USER=marketplace
POSTGRES_PASSWORD=marketplace123
POSTGRES_DB=marketplace
POSTGRES_PORT=5432

# Full DATABASE_URL (auto-generated in docker-compose)
# DATABASE_URL=postgresql://marketplace:marketplace123@localhost:5432/marketplace?schema=public

# ==========================================
# Redis (Cache & Sessions)
# ==========================================
REDIS_PORT=6379
REDIS_PASSWORD=
# Leave empty for no password, or set a strong password for production

# Full REDIS_URL (auto-generated in docker-compose)
# REDIS_URL=redis://localhost:6379

# ==========================================
# Application Ports
# ==========================================
BACKEND_PORT=3001
FRONTEND_PORT=3000

# ==========================================
# URLs
# ==========================================
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001

# ==========================================
# JWT & Authentication
# ==========================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production-minimum-32-characters
JWT_EXPIRY=7d
# Options: 1h, 24h, 7d, 30d

# ==========================================
# File Upload (ImageKit.io)
# Sign up at https://imagekit.io
# ==========================================
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# ==========================================
# Email Service (Resend)
# Sign up at https://resend.com
# ==========================================
RESEND_API_KEY=re_your_resend_api_key

# ==========================================
# Error Tracking (Sentry)
# Sign up at https://sentry.io
# ==========================================
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ==========================================
# Analytics (PostHog)
# Sign up at https://posthog.com
# ==========================================
POSTHOG_API_KEY=phc_your_posthog_api_key

# ==========================================
# Background Jobs (Inngest)
# Sign up at https://inngest.com
# ==========================================
INNGEST_EVENT_KEY=your_inngest_event_key
INNGEST_SIGNING_KEY=your_inngest_signing_key

# ==========================================
# AI Services (for Chatbot)
# ==========================================

# OpenAI
# Sign up at https://platform.openai.com
OPENAI_API_KEY=sk-your-openai-api-key

# Anthropic (Claude)
# Sign up at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# ==========================================
# WhatsApp Business API
# Sign up at https://developers.facebook.com
# ==========================================
WHATSAPP_API_TOKEN=your_whatsapp_api_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id

# ==========================================
# Payment Gateways (Optional)
# ==========================================

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# M-Pesa (for Kenya)
MPESA_CONSUMER_KEY=your_mpesa_consumer_key
MPESA_CONSUMER_SECRET=your_mpesa_consumer_secret
MPESA_SHORTCODE=your_mpesa_shortcode
MPESA_PASSKEY=your_mpesa_passkey

# ==========================================
# SMS Service (Optional)
# ==========================================
AFRICASTALKING_API_KEY=your_africastalking_api_key
AFRICASTALKING_USERNAME=your_africastalking_username

# ==========================================
# Security & Rate Limiting (Arcjet)
# Sign up at https://arcjet.com
# ==========================================
ARCJET_KEY=your_arcjet_key
